# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_USER=supplier_safety_form
DB_PASSWORD=
DB_NAME=supplier_safety_form_dev_db
DB_SSLMODE=disable

# Keycloak — realm dédié "supplier-safety-form" (séparé du realm pra)
KEYCLOAK_ISSUER_URL=https://auth-dev.drp-safe.com/realms/supplier-safety-form
KEYCLOAK_CLIENT_ID=supplier-safety-form-frontend
KEYCLOAK_INTERNAL_URL=http://keycloak.keycloak-dev.svc.cluster.local:8080
KEYCLOAK_TRUSTED_AZPS=
# Compte admin du realm master, utilisé pour créer les comptes utilisateurs à
# l'inscription (même compte que celui déjà utilisé par pra2).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Chiffrement au repos (mot de passe SMTP en base) — 32 caractères exactement.
ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
APP_ENV=development
PORT=8080
