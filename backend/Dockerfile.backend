FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/supplier-safety-form-backend ./cmd/api

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -g 1001 -S appuser 2>/dev/null; adduser -u 1001 -S -G root appuser 2>/dev/null \
    || adduser -D -u 1001 appuser
COPY --from=builder /app/supplier-safety-form-backend /app/supplier-safety-form-backend
RUN chown -R appuser /app
USER appuser

EXPOSE 8080
CMD ["/app/supplier-safety-form-backend"]
